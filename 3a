import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive UI Dashboard',
      theme: ThemeData(
        primarySwatch: Colors.indigo,
        useMaterial3: true,
      ),
      home: const DashboardScreen(),
    );
  }
}

class DashboardScreen extends StatelessWidget {
  const DashboardScreen({super.key});

  // Step 3: Determine device category based on breakpoint thresholds
  String _getScreenCategory(double width) {
    if (width < 600) {
      return 'Mobile';
    } else if (width < 1024) {
      return 'Tablet';
    } else {
      return 'Desktop';
    }
  }

  @override
  Widget build(BuildContext context) {
    // Step 2 & 4: Retrieve MediaQuery details and listen to Orientation changes
    final mediaQuery = MediaQuery.of(context);
    final double screenWidth = mediaQuery.size.width;

    return OrientationBuilder(
      builder: (context, orientation) {
        final String orientationString =
            orientation == Orientation.portrait ? 'Portrait' : 'Landscape';
        final String category = _getScreenCategory(screenWidth);

        return Scaffold(
          appBar: AppBar(
            title: Text('Responsive Dashboard ($category -$orientationString)'),
            backgroundColor: Colors.indigo,
            foregroundColor: Colors.white,
            elevation: 2,
          ),
          // Step 5: LayoutBuilder for constraint-based adaptive rendering
          body: LayoutBuilder(
            builder: (context, constraints) {
              final double maxWidth = constraints.maxWidth;

              // Step 9: Desktop Layout (Width >= 1024) -> NavigationRail + 3 Columns
              if (maxWidth >= 1024) {
                return _buildDesktopLayout(context, maxWidth, orientationString);
              }
              // Step 8: Tablet Layout (600 <= Width < 1024) -> 2 Columns
              else if (maxWidth >= 600) {
                return _buildTabletLayout(context, maxWidth, orientationString);
              }
              // Step 7: Mobile Layout (Width < 600) -> Adaptive Column/Row layout
              else {
                return _buildMobileLayout(
                  context,
                  maxWidth,
                  orientation,
                  orientationString,
                );
              }
            },
          ),
        );
      },
    );
  }

  // --- Mobile Layout (< 600px) ---
  Widget _buildMobileLayout(
    BuildContext context,
    double width,
    Orientation orientation,
    String orientationString,
  ) {
    return Column(
      children: [
        _HeaderWidget(category: 'Mobile', orientation: orientationString, width: width),
        Expanded(
          child: Padding(
            padding: const EdgeInsets.all(8.0),
            child: orientation == Orientation.portrait
                ? ListView(
                    children: const [
                      _DashboardCard(title: 'Analytics Card 1', color: Colors.blue),
                      _DashboardCard(title: 'Analytics Card 2', color: Colors.teal),
                      _DashboardCard(title: 'Analytics Card 3', color: Colors.orange),
                    ],
                  )
                : Row(
                    children: const [
                      Expanded(child: _DashboardCard(title: 'Analytics 1', color: Colors.blue)),
                      SizedBox(width: 8),
                      Expanded(child: _DashboardCard(title: 'Analytics 2', color: Colors.teal)),
                      SizedBox(width: 8),
                      Expanded(child: _DashboardCard(title: 'Analytics 3', color: Colors.orange)),
                    ],
                  ),
          ),
        ),
        _FooterWidget(width: width, category: 'Mobile', orientation: orientationString),
      ],
    );
  }

  // --- Tablet Layout (600px to 1023px) ---
  Widget _buildTabletLayout(
    BuildContext context,
    double width,
    String orientationString,
  ) {
    return Column(
      children: [
        _HeaderWidget(category: 'Tablet', orientation: orientationString, width: width),
        Expanded(
          child: Padding(
            padding: const EdgeInsets.all(12.0),
            child: GridView.count(
              crossAxisCount: 2,
              crossAxisSpacing: 12,
              mainAxisSpacing: 12,
              childAspectRatio: width > 800 ? 1.6 : 1.2,
              children: const [
                _DashboardCard(title: 'Overview Analytics', color: Colors.indigo),
                _DashboardCard(title: 'User Statistics', color: Colors.teal),
                _DashboardCard(title: 'Recent Transactions', color: Colors.amber),
                _DashboardCard(title: 'System Health', color: Colors.deepOrange),
              ],
            ),
          ),
        ),
        _FooterWidget(width: width, category: 'Tablet', orientation: orientationString),
      ],
    );
  }

  // --- Desktop Layout (>= 1024px) ---
  Widget _buildDesktopLayout(
    BuildContext context,
    double width,
    String orientationString,
  ) {
    return Row(
      children: [
        NavigationRail(
          selectedIndex: 0,
          onDestinationSelected: (int index) {},
          labelType: NavigationRailLabelType.all,
          destinations: const [
            NavigationRailDestination(
              icon: Icon(Icons.dashboard),
              label: Text('Dashboard'),
            ),
            NavigationRailDestination(
              icon: Icon(Icons.analytics),
              label: Text('Analytics'),
            ),
            NavigationRailDestination(
              icon: Icon(Icons.settings),
              label: Text('Settings'),
            ),
          ],
        ),
        const VerticalDivider(thickness: 1, width: 1),
        Expanded(
          child: Column(
            children: [
              _HeaderWidget(
                category: 'Desktop',
                orientation: orientationString,
                width: width,
              ),
              Expanded(
                child: Padding(
                  padding: const EdgeInsets.all(16.0),
                  child: Row(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      Expanded(
                        flex: 1,
                        child: _DashboardCard(
                          title: 'Primary Metrics (Col 1)',
                          color: Colors.indigo.shade400,
                        ),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        flex: 1,
                        child: _DashboardCard(
                          title: 'Secondary Data (Col 2)',
                          color: Colors.teal.shade400,
                        ),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        flex: 1,
                        child: _DashboardCard(
                          title: 'System Notifications (Col 3)',
                          color: Colors.purple.shade400,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
              _FooterWidget(
                width: width,
                category: 'Desktop',
                orientation: orientationString,
              ),
            ],
          ),
        ),
      ],
    );
  }
}

// Custom Header Widget
class _HeaderWidget extends StatelessWidget {
  final String category;
  final String orientation;
  final double width;

  const _HeaderWidget({
    required this.category,
    required this.orientation,
    required this.width,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16.0),
      color: Colors.indigo.shade50,
      child: Column(
        children: [
          Text(
            'Active View: $category Layout',
            style: TextStyle(
              fontSize: width < 600 ? 16 : 20,
              fontWeight: FontWeight.bold,
              color: Colors.indigo.shade900,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            'Orientation: $orientation \vert{} Screen Width:${width.toStringAsFixed(1)}px',
            style: const TextStyle(fontSize: 13, color: Colors.black87),
          ),
        ],
      ),
    );
  }
}

// Reusable Dashboard Card Widget
class _DashboardCard extends StatelessWidget {
  final String title;
  final Color color;

  const _DashboardCard({
    required this.title,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      elevation: 3,
      color: color,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Center(
          child: Text(
            title,
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: Colors.white,
              fontSize: 16,
              fontWeight: FontWeight.bold,
            ),
          ),
        ),
      ),
    );
  }
}

